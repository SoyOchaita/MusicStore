@model MusicStore.Models.Genre
@{
  ViewData["Title"] = "Editar tipo";
}

<div class="flex items-center justify-center min-h-[85vh] bg-gray-50 px-4 sm:px-6 lg:px-8">
  <div class="w-full max-w-md sm:max-w-lg lg:max-w-2xl bg-white rounded-2xl shadow-md border border-gray-100 p-6 sm:p-8 lg:p-10 space-y-6 transition-all">

    <!-- Header visual -->
    <div class="flex items-center gap-3 sm:gap-4">
      <div class="h-12 w-12 sm:h-14 sm:w-14 flex items-center justify-center rounded-full bg-blue-100 text-blue-600 shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6 sm:w-7 sm:h-7">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.125-1.125a1.125 1.125 0 011.59 1.591l-1.125 1.125M16.862 4.487l-8.7 8.7a4.5 4.5 0 01-1.91 1.142l-2.316.578.578-2.316a4.5 4.5 0 011.142-1.91l8.7-8.7" />
        </svg>
      </div>
      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-gray-800 leading-tight">
        Editar tipo
      </h1>
    </div>

    <!-- Formulario -->
    <form asp-action="Edit" method="post" class="space-y-6">
      @Html.AntiForgeryToken()
      <input type="hidden" asp-for="Id" />

      <!-- Campo Nombre -->
      <div class="space-y-1">
        <label asp-for="Name" class="block text-sm font-medium text-gray-700">Nombre</label>
        <input asp-for="Name" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-blue-400 transition" />
        <span asp-validation-for="Name" class="text-red-600 text-sm"></span>
      </div>

      <!-- Botones -->
      <div class="flex flex-col sm:flex-row gap-3 pt-4">
        <button type="submit" 
                class="flex-1 flex justify-center items-center gap-2 bg-blue-600 text-white font-medium py-2.5 sm:py-3 sm:px-5 rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-400 transition">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 sm:w-6 sm:h-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          <span class="text-sm sm:text-base">Guardar cambios</span>
        </button>

        <a asp-action="Index"
           class="flex-1 flex justify-center items-center gap-2 bg-gray-200 text-gray-900 font-medium py-2.5 sm:py-3 sm:px-5 rounded-lg hover:bg-gray-300 transition">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 sm:w-6 sm:h-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
          <span class="text-sm sm:text-base">Volver al listado</span>
        </a>
      </div>
    </form>

  </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
