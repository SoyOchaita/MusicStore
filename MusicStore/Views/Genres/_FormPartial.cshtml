@model MusicStore.Models.Genre

<!-- Resumen de validaciones -->
<div asp-validation-summary="All" class="text-red-600 text-sm mb-4 bg-red-50 border border-red-100 rounded-lg p-3"></div>

<!-- Grid del formulario -->
<div class="grid grid-cols-1 sm:grid-cols-2 gap-5">

  <!-- Campo Nombre -->
  <div class="sm:col-span-2">
    <label asp-for="Name" class="block text-sm font-medium text-gray-700 mb-1">
      Nombre
    </label>
    <input asp-for="Name"
           class="w-full border border-gray-300 rounded-lg px-3 py-2.5 text-gray-900 focus:outline-none focus:ring-2 focus:ring-green-400 focus:border-green-400 transition placeholder-gray-400"
           placeholder="Ejemplo: Rock, Pop, Clásico..." />
    <span asp-validation-for="Name" class="text-red-600 text-sm mt-1 block"></span>
  </div>

</div>