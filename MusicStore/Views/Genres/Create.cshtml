@model MusicStore.Models.Genre
@{
  ViewData["Title"] = "Nuevo tipo";
}

<div class="flex items-center justify-center min-h-[85vh] bg-gray-50 px-4 sm:px-6 lg:px-8">
  <div class="w-full max-w-md sm:max-w-lg lg:max-w-2xl bg-white rounded-2xl shadow-md border border-gray-100 p-6 sm:p-8 lg:p-10 space-y-6 transition-all">

    <!-- Header visual -->
    <div class="flex items-center gap-3 sm:gap-4">
      <div class="h-12 w-12 sm:h-14 sm:w-14 flex items-center justify-center rounded-full bg-green-100 text-green-600 shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6 sm:w-7 sm:h-7" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
        </svg>
      </div>
      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-gray-800 leading-tight">
        Crear tipo
      </h1>
    </div>

    <!-- Formulario -->
    <form asp-action="Create" method="post" class="space-y-6">
      @Html.AntiForgeryToken()

      <!-- Campo Nombre -->
      <div class="space-y-1">
        <label asp-for="Name" class="block text-sm font-medium text-gray-700">Nombre</label>
        <input asp-for="Name"
               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-gray-900 focus:outline-none focus:ring-2 focus:ring-green-400 focus:border-green-400 transition" />
        <span asp-validation-for="Name" class="text-red-600 text-sm"></span>
      </div>

      <!-- Botones -->
      <div class="flex flex-col sm:flex-row gap-3 pt-4">
        <!-- Guardar -->
        <button type="submit"
          class="flex-1 flex justify-center items-center gap-2 bg-green-600 text-white font-medium py-2.5 sm:py-3 sm:px-5 rounded-lg hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-400 transition" aria-label="Guardar">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 sm:w-6 sm:h-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          <span class="text-sm sm:text-base">Guardar</span>
        </button>

        <!-- Cancelar -->
        <a asp-action="Index"
           class="flex-1 flex justify-center items-center gap-2 bg-gray-200 text-gray-900 font-medium py-2.5 sm:py-3 sm:px-5 rounded-lg hover:bg-gray-300 transition" aria-label="Cancelar">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 sm:w-6 sm:h-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
          <span class="text-sm sm:text-base">Cancelar</span>
        </a>
      </div>
    </form>

  </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
