@model IEnumerable<MusicStore.Models.Genre>
@{
    ViewData["Title"] = "Store";
}
<h2>Géneros</h2>
<ul>
    @foreach (var g in Model)
    {
        <li>
            <a asp-controller="Store" asp-action="Browse" asp-route-genreId="@g.Id">
                @g.Name
            </a>
        </li>
    }
</ul>
