@model IEnumerable<MusicStore.Models.Album>
@{
    ViewData["Title"] = "Catalogo de gorras";
    var brands = ViewBag.Brands as List<MusicStore.Models.Artist> ?? new();
    var types = ViewBag.Types as List<MusicStore.Models.Genre> ?? new();
    var classes = ViewBag.Classes as List<string> ?? new();
    int? selectedBrandId = ViewBag.SelectedBrandId as int?;
    int? selectedTypeId = ViewBag.SelectedTypeId as int?;
    string selectedProductClass = ViewBag.SelectedProductClass as string ?? string.Empty;
    string search = ViewBag.Search as string ?? string.Empty;
    string selectedStockOrder = ViewBag.SelectedStockOrder as string ?? "stockDesc";
}
<div class="min-h-screen bg-gray-50">
    <div class="max-w-[1500px] mx-auto px-3 sm:px-4 lg:px-6 py-5 sm:py-6">
        <div class="bg-white border border-gray-200 rounded-2xl shadow-sm p-4 sm:p-5 mb-6">
            <div class="flex flex-col gap-4">
                <div class="flex items-center justify-between gap-3">
                    <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-gray-900">Catalogo de gorras</h1>
                    <span class="text-xs sm:text-sm text-gray-500">@Model.Count() productos</span>
                </div>

                <form method="get" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-2.5 items-center">
                <input name="search" value="@search" class="lg:col-span-3 border border-gray-300 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-black/20" placeholder="Buscar por nombre o codigo" />

                <select name="brandId" class="lg:col-span-2 border border-gray-300 rounded-lg px-3 py-2.5 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-black/20">
                    <option value="">Todas las marcas</option>
                    @foreach (var brand in brands)
                    {
                        <option value="@brand.Id" selected="@(selectedBrandId.HasValue && selectedBrandId.Value == brand.Id ? "selected" : null)">@brand.Name</option>
                    }
                </select>

                <select name="typeId" class="lg:col-span-2 border border-gray-300 rounded-lg px-3 py-2.5 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-black/20">
                    <option value="">Todos los tipos</option>
                    @foreach (var type in types)
                    {
                        <option value="@type.Id" selected="@(selectedTypeId.HasValue && selectedTypeId.Value == type.Id ? "selected" : null)">@type.Name</option>
                    }
                </select>

                <select name="productClass" class="lg:col-span-2 border border-gray-300 rounded-lg px-3 py-2.5 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-black/20">
                    <option value="">Todas las clases</option>
                    @foreach (var itemClass in classes)
                    {
                        <option value="@itemClass" selected="@(selectedProductClass == itemClass ? "selected" : null)">@itemClass</option>
                    }
                </select>

                <select name="stockOrder" class="lg:col-span-2 border border-gray-300 rounded-lg px-3 py-2.5 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-black/20">
                    <option value="stockDesc" selected="@(selectedStockOrder == "stockDesc" ? "selected" : null)">Stock: mayor a menor</option>
                    <option value="stockAsc" selected="@(selectedStockOrder == "stockAsc" ? "selected" : null)">Stock: menor a mayor</option>
                    <option value="nameAsc" selected="@(selectedStockOrder == "nameAsc" ? "selected" : null)">Nombre A-Z</option>
                </select>

                <button class="lg:col-span-1 bg-black text-white px-4 py-2.5 rounded-lg text-sm font-medium hover:bg-gray-800 transition">Filtrar</button>
            </form>
        </div>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-5 gap-3 sm:gap-4 lg:gap-5">
            @foreach (var product in Model)
            {
                <article class="group bg-white border border-gray-200 rounded-xl overflow-hidden shadow-sm hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200">
                    <div class="aspect-square w-full overflow-hidden relative bg-gradient-to-br from-gray-100 to-gray-200">
                        @if (product.Stock <= 0)
                        {
                            <span class="absolute top-3 -left-11 z-10 w-40 text-center bg-black text-white text-[10px] font-bold tracking-[0.18em] py-1 rotate-[-36deg] border border-white/60 shadow-md select-none">
                                AGOTADO
                            </span>
                        }

                        @if (!string.IsNullOrWhiteSpace(product.AlbumArtUrl))
                        {
                            <img src="@Url.Content(product.AlbumArtUrl)"
                                 alt="@product.Title"
                                 class="absolute inset-0 w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-300"
                                 loading="lazy" />
                        }
                        else
                        {
                            <div class="absolute inset-0 flex items-center justify-center text-6xl text-gray-300 select-none">
                                @(string.IsNullOrWhiteSpace(product.Title) ? "★" : (product.Title.Trim()[0].ToString().ToLower()))
                            </div>
                        }
                    </div>

                    <div class="p-3.5 sm:p-4">
                        <div class="flex items-start justify-between gap-2">
                            <h3 class="text-[15px] sm:text-base leading-tight font-semibold text-gray-900 line-clamp-2 min-h-[2.4rem]">@product.Title</h3>
                            <span class="text-[10px] sm:text-xs font-semibold text-gray-500 bg-gray-100 rounded-full px-2 py-0.5 shrink-0">@product.Code</span>
                        </div>

                        <div class="mt-2 flex flex-wrap gap-1.5 text-[10px] sm:text-xs">
                            <span class="px-2 py-0.5 rounded-full bg-gray-100 text-gray-700">@product.Artist?.Name</span>
                            <span class="px-2 py-0.5 rounded-full bg-gray-100 text-gray-700">@product.Genre?.Name</span>
                            <span class="px-2 py-0.5 rounded-full bg-gray-100 text-gray-700">@product.ProductClass</span>
                        </div>

                        <div class="mt-3 flex items-center justify-between gap-2">
                            <p class="text-xl sm:text-2xl font-bold tracking-tight text-gray-900">@($"Q{product.Price:0.00}")</p>
                            <span class="text-[11px] sm:text-xs font-semibold px-2.5 py-1 rounded-full @(product.Stock > 0 ? "bg-emerald-50 text-emerald-700" : "bg-rose-50 text-rose-700")">
                                Stock: @product.Stock
                            </span>
                        </div>
                    </div>

                    <div class="px-3.5 sm:px-4 pb-4 space-y-2">
                        <form asp-controller="ShoppingCart" asp-action="AddToCart" method="post" class="block w-full">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@product.Id" />
                            <button type="submit" class="w-full text-center bg-black text-white text-sm font-medium py-2.5 rounded-lg hover:bg-gray-800 disabled:bg-gray-300 disabled:text-gray-600 transition" disabled="@(product.Stock <= 0)">
                                Agregar al carrito
                            </button>
                        </form>

                        <a asp-controller="Store" asp-action="Details" asp-route-id="@product.Id"
                           class="block text-center text-sm text-gray-700 hover:text-black hover:underline">
                            Ver detalles
                        </a>
                    </div>
                </article>
            }
        </div>
    </div>
</div>
