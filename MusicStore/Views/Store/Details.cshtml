@model MusicStore.Models.Album
@{
    ViewData["Title"] = Model.Title;
}
<h2>@Model.Title</h2>
<p><strong>Artista:</strong> @Model.Artist?.Name</p>
<p><strong>Género:</strong> @Model.Genre?.Name</p>
<p><strong>Precio:</strong> @($"Q{Model.Price:0.00}")</p>

<p><a asp-controller="Store" asp-action="Browse" asp-route-genreId="@Model.GenreId">← Volver a @Model.Genre?.Name</a></p>

<form asp-controller="ShoppingCart" asp-action="Add" method="post" class="mt-3">
    <input type="hidden" name="id" value="@Model.Id" />
    <button class="btn btn-primary">Agregar al carrito</button>
</form>