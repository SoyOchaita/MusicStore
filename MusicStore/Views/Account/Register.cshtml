@model MusicStore.Models.RegisterViewModel
@{
    ViewData["Title"] = "Registrarse";
}
<div class="min-h-screen bg-gray-50">
  <div class="max-w-md mx-auto mt-20 bg-white shadow-lg rounded-lg p-8">
    <h1 class="text-2xl font-semibold text-gray-800 mb-6">Crear cuenta</h1>
    <form asp-action="Register" method="post" class="space-y-4">
      @Html.AntiForgeryToken()
      <div asp-validation-summary="All" class="text-red-600 text-sm mb-2"></div>
      <div>
        <label asp-for="Email" class="block text-sm text-gray-700 mb-1">Correo electrónico</label>
        <input asp-for="Email" class="w-full border rounded-md p-2 focus:outline-none focus:ring-2 focus:ring-gray-800" />
        <span asp-validation-for="Email" class="text-red-600 text-sm"></span>
      </div>
      <div>
        <label asp-for="Password" class="block text-sm text-gray-700 mb-1">Contraseña</label>
        <input asp-for="Password" class="w-full border rounded-md p-2 focus:outline-none focus:ring-2 focus:ring-gray-800" />
        <span asp-validation-for="Password" class="text-red-600 text-sm"></span>
      </div>
      <div>
        <label asp-for="ConfirmPassword" class="block text-sm text-gray-700 mb-1">Confirmar contraseña</label>
        <input asp-for="ConfirmPassword" class="w-full border rounded-md p-2 focus:outline-none focus:ring-2 focus:ring-gray-800" />
        <span asp-validation-for="ConfirmPassword" class="text-red-600 text-sm"></span>
      </div>
      <button type="submit" class="w-full bg-black text-white hover:bg-gray-800 rounded-md py-2 transition">Registrarse</button>
    </form>
    <div class="mt-4 text-sm">
      <span class="text-gray-600">¿Ya tienes una cuenta?</span>
      <a asp-controller="Account" asp-action="Login" class="ml-2 text-gray-800 hover:underline">Inicia sesión</a>
    </div>
  </div>
</div>