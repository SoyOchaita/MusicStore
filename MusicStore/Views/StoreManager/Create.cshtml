@model MusicStore.Models.Album
@{
  ViewData["Title"] = "Crear gorra";
}

<div class="flex items-center justify-center min-h-[85vh] bg-gray-50 px-4 sm:px-6 lg:px-8">
  <div class="w-full max-w-md sm:max-w-lg lg:max-w-3xl bg-white rounded-2xl shadow-md border border-gray-100 p-6 sm:p-8 lg:p-10 space-y-6 transition-all">

    <!-- HEADER -->
    <div class="flex items-center gap-3 sm:gap-4">
      <div class="h-12 w-12 sm:h-14 sm:w-14 flex items-center justify-center rounded-full bg-indigo-100 text-indigo-600 shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6 sm:w-7 sm:h-7">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
        </svg>
      </div>
      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-indigo-700 leading-tight">
        Crear nueva gorra
      </h1>
    </div>

    <!-- DESCRIPCIÓN -->
    <p class="text-gray-700 text-base sm:text-lg leading-relaxed">
      Completa los siguientes campos para registrar una nueva gorra en el sistema.
    </p>

    <!-- FORMULARIO -->
    <form asp-action="Create" method="post" enctype="multipart/form-data" class="space-y-6">
      @Html.AntiForgeryToken()
      <div asp-validation-summary="ModelOnly" class="text-rose-600 text-sm"></div>

      <!-- GRID DE CAMPOS -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">

        <div>
          <label asp-for="Code" class="block text-sm font-medium text-gray-700 mb-1">Codigo</label>
          <input asp-for="Code" autocomplete="off" required
                 class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-400"
                 placeholder="Ejemplo: A83" />
          <span asp-validation-for="Code" class="text-rose-600 text-sm"></span>
        </div>

        <div>
          <label asp-for="ProductClass" class="block text-sm font-medium text-gray-700 mb-1">Clase</label>
          <select asp-for="ProductClass" class="w-full border border-gray-300 rounded-lg px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-indigo-400">
            <option value="Ajustable">Ajustable</option>
            <option value="Unitalla">Unitalla</option>
          </select>
          <span asp-validation-for="ProductClass" class="text-rose-600 text-sm"></span>
        </div>

        <div class="md:col-span-2">
          <label asp-for="Title" class="block text-sm font-medium text-gray-700 mb-1">Nombre de la gorra</label>
          <input asp-for="Title" autocomplete="off" required
                 class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-400"
                 placeholder="Ejemplo: Black / Yankees / Plana" />
          <span asp-validation-for="Title" class="text-rose-600 text-sm"></span>
        </div>

        <div>
          <label asp-for="GenreId" class="block text-sm font-medium text-gray-700 mb-1">Tipo</label>
          <select asp-for="GenreId" asp-items="ViewBag.GenreId" required
                  class="w-full border border-gray-300 rounded-lg px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-indigo-400">
            <option value="">-- Seleccione un tipo --</option>
          </select>
          <span asp-validation-for="GenreId" class="text-rose-600 text-sm"></span>
        </div>

        <div>
          <label asp-for="ArtistId" class="block text-sm font-medium text-gray-700 mb-1">Marca</label>
          <select asp-for="ArtistId" asp-items="ViewBag.ArtistId" required
                  class="w-full border border-gray-300 rounded-lg px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-indigo-400">
            <option value="">-- Seleccione una marca --</option>
          </select>
          <span asp-validation-for="ArtistId" class="text-rose-600 text-sm"></span>
        </div>

        <div>
          <label asp-for="Stock" class="block text-sm font-medium text-gray-700 mb-1">Stock</label>
          <input asp-for="Stock" type="number" min="0"
                 class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-400" />
          <span asp-validation-for="Stock" class="text-rose-600 text-sm"></span>
        </div>

        <div>
          <label asp-for="Price" class="block text-sm font-medium text-gray-700 mb-1">Precio (Q)</label>
          <input asp-for="Price" type="number" inputmode="decimal" step="0.01" min="0" autocomplete="off"
                 class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-400"
                 placeholder="Ejemplo: 120.00" />
          <span asp-validation-for="Price" class="text-rose-600 text-sm"></span>
        </div>

        <!-- IMAGEN -->
        <div class="md:col-span-2 space-y-2">
          <label asp-for="AlbumArtUrl" class="block text-sm font-medium text-gray-700">Imagen (URL)</label>
          <input asp-for="AlbumArtUrl" id="albumArtUrlInput" type="url" autocomplete="off"
                 class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-400"
                 placeholder="https://..." />
          <input id="albumImageInput" type="file" name="albumImage" accept="image/*" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-400" />
          <span asp-validation-for="AlbumArtUrl" class="text-rose-600 text-sm"></span>

          @{
            var initialImageUrl = string.IsNullOrWhiteSpace(Model?.AlbumArtUrl)
              ? string.Empty
              : Url.Content(Model.AlbumArtUrl);
          }
          <div class="mt-2 flex items-center gap-3">
            <div class="w-24 h-24 rounded-lg border border-gray-200 bg-gray-50 overflow-hidden flex items-center justify-center">
              <img id="imagePreview" src="@initialImageUrl" alt="Previsualización de imagen" class="w-full h-full object-cover @(string.IsNullOrWhiteSpace(initialImageUrl) ? "hidden" : string.Empty)" />
              <span id="imagePreviewPlaceholder" class="text-[11px] text-gray-500 @(string.IsNullOrWhiteSpace(initialImageUrl) ? string.Empty : "hidden")">Sin imagen</span>
            </div>
            <p class="text-xs text-gray-500">Vista previa</p>
          </div>
        </div>

      </div>

      <!-- BOTONES -->
      <div class="pt-4 flex flex-col sm:flex-row gap-3 border-t border-gray-100">
        <!-- GUARDAR -->
        <button type="submit"
          class="flex-1 flex justify-center items-center gap-2 bg-black text-white font-medium py-2.5 sm:py-3 sm:px-5 rounded-lg hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-black/40 transition"
          aria-label="Guardar gorra">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 sm:w-6 sm:h-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          <span class="text-sm sm:text-base">Guardar</span>
        </button>

        <!-- CANCELAR -->
        <a asp-action="Index"
          class="flex-1 flex justify-center items-center gap-2 bg-gray-200 text-gray-900 font-medium py-2.5 sm:py-3 sm:px-5 rounded-lg hover:bg-gray-300 transition"
          aria-label="Cancelar">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 sm:w-6 sm:h-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
          <span class="text-sm sm:text-base">Cancelar</span>
        </a>
      </div>
    </form>

  </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
      (function () {
        const urlInput = document.getElementById("albumArtUrlInput");
        const fileInput = document.getElementById("albumImageInput");
        const previewImage = document.getElementById("imagePreview");
        const previewPlaceholder = document.getElementById("imagePreviewPlaceholder");

        if (!previewImage || !previewPlaceholder) return;

        let objectUrl = null;

        const showPreview = function (src) {
          previewImage.src = src;
          previewImage.classList.remove("hidden");
          previewPlaceholder.classList.add("hidden");
        };

        const showPlaceholder = function () {
          previewImage.removeAttribute("src");
          previewImage.classList.add("hidden");
          previewPlaceholder.classList.remove("hidden");
        };

        const cleanupObjectUrl = function () {
          if (objectUrl) {
            URL.revokeObjectURL(objectUrl);
            objectUrl = null;
          }
        };

        urlInput?.addEventListener("input", function () {
          if (fileInput?.files?.length) return;
          cleanupObjectUrl();
          const value = urlInput.value.trim();
          if (!value) {
            showPlaceholder();
            return;
          }
          showPreview(value);
        });

        fileInput?.addEventListener("change", function () {
          cleanupObjectUrl();

          const file = fileInput.files && fileInput.files[0];
          if (!file) {
            const value = urlInput?.value.trim() ?? "";
            if (!value) {
              showPlaceholder();
              return;
            }
            showPreview(value);
            return;
          }

          objectUrl = URL.createObjectURL(file);
          showPreview(objectUrl);
        });
      })();
    </script>
}
