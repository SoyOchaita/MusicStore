@model IEnumerable<MusicStore.Models.Order>
@{
    ViewData["Title"] = "Mi perfil";
}
<div class="min-h-screen bg-gray-50">
    <div class="max-w-6xl mx-auto p-4 grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white rounded-lg shadow p-6">
            <h2 class="text-xl font-semibold mb-2">Perfil</h2>
            <p class="text-gray-700">Usuario: <strong>@User.Identity?.Name</strong></p>
        </div>

        <div class="bg-white rounded-lg shadow p-6 md:col-span-2">
            <h2 class="text-xl font-semibold mb-4">Historial de pedidos</h2>
            @if (!Model.Any())
            {
                <p class="text-gray-600">No hay pedidos aún.</p>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="min-w-full">
                        <thead class="bg-gray-100">
                            <tr>
                                <th class="text-left p-3">Orden</th>
                                <th class="text-left p-3">Fecha</th>
                                <th class="text-right p-3">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var o in Model)
                            {
                                <tr class="border-t">
                                    <td class="p-3">@o.OrderId</td>
                                    <td class="p-3">@o.OrderDate.ToLocalTime().ToString("g")</td>
                                    <td class="p-3 text-right">@o.Total.ToString("C")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>