@model MusicStore.Models.ErrorViewModel
@{
    ViewData["Title"] = "Error";
}
<h1 class="text-danger">Ha ocurrido un error.</h1>
<p>Intenta nuevamente más tarde. Si el problema persiste, contacta al administrador.</p>
@if (Model?.ShowRequestId ?? false)
{
    <p><strong>Request ID:</strong> @Model.RequestId</p>
}
