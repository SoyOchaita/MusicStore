@model MusicStore.Models.Artist
@{
  ViewData["Title"] = "Detalles de la marca";
}
<div class="flex items-center justify-center min-h-[85vh] bg-gray-50 px-4 sm:px-6 lg:px-8">
  <div class="w-full max-w-xl bg-white rounded-2xl shadow-md border border-gray-100 p-6 sm:p-8 space-y-6">

    <h1 class="text-2xl sm:text-3xl font-bold text-gray-800 flex items-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-gray-700" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5.121 17.804A13.937 13.937 0 0112 15c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0z"/>
      </svg>
      Detalles de la marca
    </h1>

    <div class="space-y-4">
      <div class="bg-gray-50 border border-gray-200 rounded-xl p-4 sm:p-6">
        <div class="text-sm font-medium text-gray-500 mb-1">Imagen</div>
        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
        {
          <img src="@Url.Content(Model.ImageUrl)" alt="@Model.Name" class="w-28 h-28 object-cover rounded-lg border" onerror="this.style.display='none';" />
        }
        else
        {
          <span class="text-gray-400 italic">Sin imagen</span>
        }
      </div>

      <div class="bg-gray-50 border border-gray-200 rounded-xl p-4 sm:p-6">
        <div class="text-sm font-medium text-gray-500 mb-1">ID</div>
        <div class="text-lg sm:text-xl font-semibold text-gray-900">@Model.Id</div>
      </div>

      <div class="bg-gray-50 border border-gray-200 rounded-xl p-4 sm:p-6">
        <div class="text-sm font-medium text-gray-500 mb-1">Nombre</div>
        <div class="text-lg sm:text-xl font-semibold text-gray-900">@Model.Name</div>
      </div>
    </div>

    <div class="pt-2 sm:pt-4 flex flex-col sm:flex-row gap-3">
      <a asp-action="Edit" asp-route-id="@Model.Id" class="flex-1 flex justify-center items-center gap-2 bg-black text-white font-medium py-2.5 sm:py-3 sm:px-5 rounded-lg hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-black/40 transition">Editar</a>
      <a asp-action="Index" class="flex-1 flex justify-center items-center gap-2 bg-gray-200 text-gray-900 font-medium py-2.5 sm:py-3 sm:px-5 rounded-lg hover:bg-gray-300 focus:outline-none focus:ring-2 focus:ring-gray-300 transition">Volver al listado</a>
    </div>

  </div>
</div>
