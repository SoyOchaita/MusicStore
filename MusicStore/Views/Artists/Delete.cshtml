@model MusicStore.Models.Artist
@{
  ViewData["Title"] = "Eliminar marca";
}

<div class="flex items-center justify-center min-h-[85vh] bg-gray-50 px-4 sm:px-6 lg:px-8">
  <div class="w-full max-w-md sm:max-w-lg lg:max-w-2xl bg-white rounded-2xl shadow-md border border-gray-100 p-6 sm:p-8 lg:p-10 space-y-6 transition-all">

    <!-- HEADER -->
    <div class="flex items-center gap-3 sm:gap-4">
      <div class="h-12 w-12 sm:h-14 sm:w-14 flex items-center justify-center rounded-full bg-red-100 text-red-600 shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 sm:w-7 sm:h-7" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3m-4 0h14" />
        </svg>
      </div>
      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-red-700 leading-tight">
        Eliminar marca
      </h1>
    </div>

    <!-- DESCRIPCIÓN -->
    <p class="text-gray-700 text-base sm:text-lg leading-relaxed">
      ¿Estás seguro de que deseas eliminar este registro?
      <span class="font-semibold text-gray-900">Esta acción no se puede deshacer.</span>
    </p>

    <!-- DATOS -->
    <div class="bg-gray-50 border border-gray-200 rounded-xl p-4 sm:p-6">
      <div class="text-sm font-medium text-gray-500 mb-1">Nombre</div>
      <div class="text-lg sm:text-xl font-semibold text-gray-900">@Model.Name</div>
    </div>

    <!-- ACCIONES -->
    <form asp-action="Delete" method="post" class="pt-4 flex flex-col sm:flex-row gap-3">
      @Html.AntiForgeryToken()
      <input type="hidden" asp-for="Id" />

      <button type="submit"
        class="flex-1 flex justify-center items-center gap-2 bg-red-600 text-white font-medium py-2.5 sm:py-3 sm:px-5 rounded-lg hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-400/50 transition"
        aria-label="Eliminar definitivamente">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 sm:w-6 sm:h-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3m-4 0h14" />
        </svg>
        <span class="text-sm sm:text-base">Eliminar definitivamente</span>
      </button>

      <a asp-action="Index"
        class="flex-1 flex justify-center items-center gap-2 bg-gray-200 text-gray-900 font-medium py-2.5 sm:py-3 sm:px-5 rounded-lg hover:bg-gray-300 focus:outline-none focus:ring-2 focus:ring-gray-300 transition"
        aria-label="Cancelar">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 sm:w-6 sm:h-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        <span class="text-sm sm:text-base">Cancelar</span>
      </a>
    </form>

  </div>
</div>
