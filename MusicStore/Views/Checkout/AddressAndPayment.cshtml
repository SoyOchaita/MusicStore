@model MusicStore.Models.Order
@{
    ViewData["Title"] = "Confirmar pedido";
}
<div class="min-h-screen bg-gray-50">
    <div class="max-w-2xl mx-auto bg-white shadow-lg p-8 mt-12 rounded-lg">
        <h1 class="text-2xl font-semibold text-gray-800 mb-6">Datos del cliente</h1>
        <form asp-action="AddressAndPayment" method="post" class="space-y-4">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-red-600 text-sm"></div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label asp-for="FirstName" class="block text-sm text-gray-700 mb-1">Nombre</label>
                    <input asp-for="FirstName" class="w-full border rounded-md p-2" />
                </div>
                <div>
                    <label asp-for="LastName" class="block text-sm text-gray-700 mb-1">Apellido</label>
                    <input asp-for="LastName" class="w-full border rounded-md p-2" />
                </div>
            </div>

            <div>
                <label asp-for="Address" class="block text-sm text-gray-700 mb-1">Dirección</label>
                <input asp-for="Address" class="w-full border rounded-md p-2" />
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                    <label asp-for="City" class="block text-sm text-gray-700 mb-1">Ciudad</label>
                    <input asp-for="City" class="w-full border rounded-md p-2" />
                </div>
                <div>
                    <label asp-for="State" class="block text-sm text-gray-700 mb-1">Estado</label>
                    <input asp-for="State" class="w-full border rounded-md p-2" />
                </div>
                <div>
                    <label asp-for="PostalCode" class="block text-sm text-gray-700 mb-1">Código Postal</label>
                    <input asp-for="PostalCode" class="w-full border rounded-md p-2" />
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label asp-for="Phone" class="block text-sm text-gray-700 mb-1">Teléfono</label>
                    <input asp-for="Phone" class="w-full border rounded-md p-2" />
                </div>
                <div>
                    <label asp-for="PaymentMethod" class="block text-sm text-gray-700 mb-1">Método de pago</label>
                    <select asp-for="PaymentMethod" class="w-full border rounded-md p-2">
                        <option value="Tarjeta">Tarjeta</option>
                        <option value="Transferencia">Transferencia</option>
                        <option value="Efectivo">Efectivo</option>
                    </select>
                </div>
            </div>

            <button class="w-full bg-black text-white py-2 rounded-md hover:bg-gray-800">Confirmar pedido</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}