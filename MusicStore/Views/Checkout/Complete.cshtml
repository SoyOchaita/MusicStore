@model MusicStore.Models.Order
@{
    ViewData["Title"] = "Pedido completado";
    var culture = new System.Globalization.CultureInfo("es-GT");
}
<div class="min-h-screen bg-gray-50">
    <div class="max-w-3xl mx-auto bg-white shadow-lg p-8 mt-12 rounded-lg">
        <div class="flex items-center gap-3 mb-4">
            <div class="text-green-600 text-3xl">✅</div>
            <h1 class="text-2xl font-semibold text-gray-800">¡Gracias por tu compra!</h1>
        </div>

        @if (Model == null)
        {
            <div class="text-red-600">No se encontró el pedido solicitado.</div>
            <a asp-controller="Store" asp-action="Index" class="inline-block mt-3 bg-black text-white px-4 py-2 rounded-md">Volver al catálogo</a>
        }
        else
        {
            <div class="mb-6">
                <p>Número de orden: <strong>@Model.OrderId</strong></p>
                <p>Fecha: <strong>@Model.OrderDate.ToLocalTime().ToString("g")</strong></p>
                <p>Total: <strong>@Model.Total.ToString("C", culture)</strong></p>
            </div>

            <a asp-controller="Store" asp-action="Index" class="inline-block bg-black text-white px-4 py-2 rounded-md hover:bg-gray-800">Volver al catálogo</a>
            <a href="#" class="inline-block ml-2 border border-black text-black px-4 py-2 rounded-md hover:bg-gray-100">Descargar comprobante</a>
        }
    </div>
</div>