@model List<MusicStore.Models.CartItem>
@{
    ViewData["Title"] = "Carrito";
    var culture = new System.Globalization.CultureInfo("es-GT");
    decimal total = ViewBag.Total is decimal t ? t : 0m;
}

<div class="flex items-center justify-center min-h-[85vh] bg-gray-50 px-4 sm:px-6 lg:px-8">
  <div class="w-full max-w-6xl bg-white rounded-2xl shadow-md border border-gray-100 p-6 sm:p-8 lg:p-10 space-y-6 transition-all">

    <!-- Header -->
    <div class="flex items-center gap-3 sm:gap-4">
      <div class="h-12 w-12 sm:h-14 sm:w-14 flex items-center justify-center rounded-full bg-blue-100 text-blue-600 shrink-0">
        <img class="w-6 h-6 sm:w-7 sm:h-7" alt="Carrito"
             src="https://unpkg.com/heroicons@2.1.1/24/outline/shopping-cart.svg" />
      </div>
      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-gray-800 leading-tight">
        Carrito de compras
      </h1>
    </div>

    @if (Model == null || !Model.Any())
    {
      <!-- Empty state -->
      <div class="flex flex-col items-center justify-center text-center py-12">
        <div class="inline-flex items-center justify-center w-14 h-14 rounded-full bg-gray-100 mb-3">
          <img class="h-7 w-7" alt="Vacío"
               src="https://unpkg.com/heroicons@2.1.1/24/outline/inbox.svg" />
        </div>
        <p class="text-gray-700 text-base sm:text-lg">Tu carrito está vacío.</p>
        <a asp-controller="Store" asp-action="Index"
           class="mt-4 inline-flex items-center gap-2 bg-black text-white font-medium py-2.5 sm:py-3 sm:px-5 rounded-lg hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-black/40 transition">
          <img class="h-5 w-5" alt="Tienda"
               src="https://unpkg.com/heroicons@2.1.1/24/outline/magnifying-glass.svg" />
          <span>Volver a la tienda</span>
        </a>
      </div>
    }
    else
    {
      <!-- Tabla (>= md) -->
      <div class="hidden md:block rounded-2xl border border-gray-200 overflow-hidden">
        <div class="overflow-x-auto">
          <table class="min-w-full text-left">
            <thead class="bg-gray-100 text-gray-700 uppercase text-xs sm:text-sm">
              <tr>
                <th class="p-4">Álbum</th>
                <th class="p-4">Artista</th>
                <th class="p-4 text-right">Cantidad</th>
                <th class="p-4 text-right">Precio</th>
                <th class="p-4 text-right">Subtotal</th>
                <th class="p-4"></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 text-sm sm:text-base">
              @foreach (var item in Model)
              {
                var price = item.Album?.Price ?? 0m;
                <tr class="hover:bg-gray-50 transition">
                  <td class="p-4 font-medium text-gray-900">@item.Album?.Title</td>
                  <td class="p-4 text-gray-700">@item.Album?.Artist?.Name</td>
                  <td class="p-4 text-right">@item.Count</td>
                  <td class="p-4 text-right">@price.ToString("C", culture)</td>
                  <td class="p-4 text-right">@((price * item.Count).ToString("C", culture))</td>
                  <td class="p-4 text-right">
                    <form asp-controller="ShoppingCart" asp-action="RemoveFromCart" method="post" class="inline">
                      @Html.AntiForgeryToken()
                      <input type="hidden" name="id" value="@item.AlbumId" />
                      <button type="submit"
                              class="inline-flex items-center gap-2 bg-red-600 text-white py-1.5 px-3 rounded-lg hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-400/50 transition"
                              aria-label="Quitar una unidad">
                        <img class="h-4 w-4" alt="Quitar"
                             src="https://unpkg.com/heroicons@2.1.1/24/outline/minus-circle.svg" />
                        <span class="hidden lg:inline">Quitar 1</span>
                      </button>
                    </form>
                  </td>
                </tr>
              }
            </tbody>
            <tfoot class="bg-gray-50">
              <tr class="border-t">
                <td colspan="4" class="p-4 text-right font-semibold">Total</td>
                <td class="p-4 text-right font-semibold">@total.ToString("C", culture)</td>
                <td class="p-4"></td>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>

      <!-- Vista tipo cards (móvil) -->
      <div class="md:hidden space-y-3">
        @foreach (var item in Model)
        {
          var price = item.Album?.Price ?? 0m;
          <div class="border border-gray-200 rounded-xl p-4">
            <div class="flex items-start justify-between gap-3">
              <div>
                <div class="text-base font-semibold text-gray-900">@item.Album?.Title</div>
                <div class="text-sm text-gray-600">@item.Album?.Artist?.Name</div>
              </div>
              <form asp-controller="ShoppingCart" asp-action="RemoveFromCart" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@item.AlbumId" />
                <button type="submit"
                        class="inline-flex items-center justify-center bg-red-600 text-white rounded-lg p-2 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-400/50 transition"
                        aria-label="Quitar una unidad">
                  <img class="h-5 w-5" alt="Quitar"
                       src="https://unpkg.com/heroicons@2.1.1/24/outline/minus-circle.svg" />
                </button>
              </form>
            </div>

            <div class="mt-3 grid grid-cols-2 gap-2 text-sm">
              <div class="text-gray-600">Cantidad</div>
              <div class="text-right text-gray-900 font-medium">@item.Count</div>

              <div class="text-gray-600">Precio</div>
              <div class="text-right text-gray-900 font-medium">@price.ToString("C", culture)</div>

              <div class="text-gray-600">Subtotal</div>
              <div class="text-right text-gray-900 font-semibold">@((price * item.Count).ToString("C", culture))</div>
            </div>
          </div>
        }

        <div class="border border-gray-200 rounded-xl p-4 flex items-center justify-between">
          <div class="text-base font-semibold text-gray-900">Total</div>
          <div class="text-base font-semibold text-gray-900">@total.ToString("C", culture)</div>
        </div>
      </div>

      <!-- Acciones -->
      <div class="pt-2 sm:pt-4 flex flex-col sm:flex-row gap-3">
        <a asp-controller="Store" asp-action="Index"
           class="flex-1 flex justify-center items-center gap-2 bg-black text-white font-medium py-2.5 sm:py-3 sm:px-5 rounded-lg hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-black/40 transition"
           aria-label="Seguir comprando">
          <img class="h-5 w-5" alt="Seguir comprando"
               src="https://unpkg.com/heroicons@2.1.1/24/outline/arrow-left.svg" />
          <span class="hidden sm:inline">Seguir comprando</span>
        </a>

        <form asp-controller="ShoppingCart" asp-action="EmptyCart" method="post" class="flex-1">
          @Html.AntiForgeryToken()
          <button type="submit"
                  class="w-full flex justify-center items-center gap-2 bg-gray-200 text-gray-900 font-medium py-2.5 sm:py-3 sm:px-5 rounded-lg hover:bg-gray-300 focus:outline-none focus:ring-2 focus:ring-gray-300 transition"
                  aria-label="Vaciar carrito">
            <img class="h-5 w-5" alt="Vaciar carrito"
                 src="https://unpkg.com/heroicons@2.1.1/24/outline/trash.svg" />
            <span class="hidden sm:inline">Vaciar carrito</span>
          </button>
        </form>

        <a asp-controller="Checkout" asp-action="AddressAndPayment"
           class="flex-1 flex justify-center items-center gap-2 bg-green-600 text-white font-medium py-2.5 sm:py-3 sm:px-5 rounded-lg hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-400/50 transition"
           aria-label="Proceder al pago">
          <img class="h-5 w-5" alt="Pagar"
               src="https://unpkg.com/heroicons@2.1.1/24/outline/credit-card.svg" />
          <span class="hidden sm:inline">Proceder al pago</span>
        </a>
      </div>
    }
  </div>
</div>
