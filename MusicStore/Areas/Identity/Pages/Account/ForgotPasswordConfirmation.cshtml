@page
@model Microsoft.AspNetCore.Mvc.RazorPages.PageModel
@{
    ViewData["Title"] = "Correo enviado";
}
<div class="flex min-h-screen items-center justify-center bg-gray-100">
  <div class="w-full max-w-md p-8 bg-white rounded-xl shadow-md text-center">
    <h1 class="text-2xl font-bold mb-4">Revisa tu correo</h1>
    <p class="text-gray-700">Si la cuenta existe, hemos enviado un enlace para restablecer tu contraseña.</p>
    @if (TempData["PasswordResetLink"] is string link)
    {
        <p class="mt-4 text-sm">
            Enlace de prueba (solo desarrollo): <a class="text-blue-600 hover:underline" href="@link">@link</a>
        </p>
    }
    <a asp-area="" asp-controller="Home" asp-action="Index"
       class="inline-block mt-6 bg-black text-white px-4 py-2 rounded-md hover:bg-gray-800">Volver al inicio</a>
  </div>
</div>