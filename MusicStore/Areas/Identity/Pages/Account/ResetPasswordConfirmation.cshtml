@page
@model Microsoft.AspNetCore.Mvc.RazorPages.PageModel
@{
    ViewData["Title"] = "Contraseña restablecida";
}
<div class="flex min-h-screen items-center justify-center bg-gray-100">
  <div class="w-full max-w-md p-8 bg-white rounded-xl shadow-md text-center">
    <h1 class="text-2xl font-bold mb-4">¡Listo!</h1>
    <p class="text-gray-700">Tu contraseña se restableció correctamente.</p>
    <a asp-page="./Login" class="inline-block mt-6 bg-black text-white px-4 py-2 rounded-md hover:bg-gray-800">Iniciar sesión</a>
  </div>
</div>